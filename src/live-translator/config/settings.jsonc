{
    "translation": {
        // cap translator output (approx. token counts)
        "maxOutputTokens": 512
    },
    "targets": {
        // Keep counters and other non-linguistic text observable without sending
        // them to the translation provider.
        "rejectCounterLike": true
    },
    "adapters": {
        // Optional native clues, enabled by default. Changes apply after restarting the runtime.
        // Use Window source order and available text space.
        "window": true,
        // Translate the current message before its native slow reveal completes.
        "gameMessage": true
    },
    "manipulation": {
        "ignoreTranslationRegex": [],
        "overrideTranslationRegex": [],
        "substitutePlaintextBeforeTranslation": []
    },
    "diskCache": {
        "enabled": true,
        // Normal writes append JSONL records. Recovery and growth-threshold
        // compaction replace the file with one complete retained checkpoint.
        "maxMegabytes": 2048,
        "clearOnLaunch": false
    },
    "hacks": {
        // These switches apply at startup; restart the game after changes.
        // Keep hold-to-fast-forward available in every scene (hold OK/Z or LMB).
        // Off installs no speedup hooks and leaves native timing/input untouched.
        "keepFastForwardAvailable": false,
        // Simulation ticks per normal tick while held: 1–16, including fractions; default 2.
        "fastForwardMultiplier": 2,
        // Reveal message text immediately. Explicit waits and input pauses remain native.
        // Off installs no reveal hook and leaves native reveal untouched.
        "instantReveal": false,
        // ignore game exceptions (some games think nwjs 0.100 is lower than 0.90)
        "suppressGameExceptions": {
            "enabled": true,
            "showErrorAlert": true
        }
    },
    "logging": {
        "enabled": false,
        "level": "warn",
        // Testing only. Replace game text in logs and monitor feeds with stable
        // numbered glyph tokens. Translation/drawing/cache remain original.
        // Applies at startup; restart the game after changing this switch.
        "redactText": false,
        "suppressExact": []
    }
}
